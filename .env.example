# =========================================================================
# KH Cloud Environment Configuration
# Copy this file to '.env' in your project root: `cp .env.example .env`
# =========================================================================

# -------------------------------------------------------------------------
# 1. DOMAIN & SSL SETTINGS
# -------------------------------------------------------------------------
# The root domain pointing to your VPS IP address (with A record @ and wildcard *).
# Example: mycloud.io, acme.dev, yourdomain.com
BASE_DOMAIN=yourdomain.com

# Email address for Let's Encrypt automatic SSL certificate notifications
ACME_EMAIL=admin@yourdomain.com

# -------------------------------------------------------------------------
# 2. GOOGLE OAUTH (User Authentication)
# -------------------------------------------------------------------------
# Create OAuth 2.0 Client ID at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: https://auth.yourdomain.com, https://cloud.yourdomain.com
# Authorized Redirect URIs:     https://auth.yourdomain.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -------------------------------------------------------------------------
# 3. GITHUB OAUTH (Optional GitHub Sign-In)
# -------------------------------------------------------------------------
# Create OAuth App at: https://github.com/settings/developers
# Homepage URL: https://cloud.yourdomain.com
# Authorization Callback URL: https://auth.yourdomain.com/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# -------------------------------------------------------------------------
# 4. GITHUB APP INTEGRATION (GitOps Auto-Deployments)
# -------------------------------------------------------------------------
# Essential for Vercel/Railway-style repository importing & continuous deployments.
# Create App at: https://github.com/settings/apps/new
#
# Settings:
# - Homepage URL: https://cloud.yourdomain.com
# - Callback URL: https://cloud.yourdomain.com
# - Setup URL (Post-installation): https://cloud.yourdomain.com
# - Webhook URL: https://api.yourdomain.com/api/github/webhook
# - Check: "Redirect on update"
# - Where can this GitHub App be installed?: "Any account"
#
# Permissions:
# - Repository -> Contents: Read-only
# - Repository -> Metadata: Read-only
# - Repository -> Webhooks: Read & write
# - Events -> Check "Push" event
#
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=kh-cloud-app
GITHUB_APP_CLIENT_ID=Iv23liDQkhKe8l...
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret

# Multi-line PEM private key generated on the GitHub App settings page.
# Replace real newlines with '\n' and enclose in double quotes:
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEogIBAAKCAQEA...your_key...-----END RSA PRIVATE KEY-----"

# Must match the string entered in the GitHub App "Webhook Secret" box:
GITHUB_APP_WEBHOOK_SECRET=your_webhook_hmac_secret_string

# -------------------------------------------------------------------------
# 5. OBJECT STORAGE (MinIO / S3-Compatible Storage)
# -------------------------------------------------------------------------
# Root credentials for MinIO object storage container
MINIO_ROOT_USER=khcloudroot
MINIO_ROOT_PASSWORD=khcloudrootpassword

# Internal endpoint for backend communication (default: http://minio:9000)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=khcloudroot
STORAGE_SECRET_KEY=khcloudrootpassword
STORAGE_REGION=us-east-1

# -------------------------------------------------------------------------
# 6. REDIS & DDOS PROTECTION CONFIGURATION
# -------------------------------------------------------------------------
# Redis connection used for DDoS sliding-window rate limiter & cache
REDIS_URL=redis://redis:6379

# Rate limits (requests per minute per IP)
DDOS_AUTH_LIMIT=10        # Auth routes (login, register)
DDOS_API_LIMIT=60         # API endpoints (/api/*)
DDOS_GLOBAL_LIMIT=200     # Static assets, frontend pages, CDN

# Auto-ban thresholds
DDOS_BAN_THRESHOLD=5      # Ban after 5 rate-limit violations
DDOS_BAN_TTL_SECONDS=3600 # Ban duration (3600s = 1 hour)

# Optional Discord Webhook for instant security & auto-ban alerts
DDOS_ALERT_DISCORD_WEBHOOK=

# Secret key required for Admin API endpoints (sent as 'x-admin-key' header)
ADMIN_API_KEY=generate-a-strong-random-admin-key-here

# -------------------------------------------------------------------------
# 7. NEXT.JS PUBLIC CONFIGURATION
# -------------------------------------------------------------------------
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
